{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:route-semantics:city-route:1",
  "title": "Experimental persisted Chengdu definition after finalization",
  "type": "object",
  "required": ["schema_version", "route_semantic_id", "source_sha256", "source_trace_ids", "definitions", "start_anchor", "end_anchor", "ordered_segments", "road_graph_version", "extraction_version", "reconstruction_status", "distance", "planning_mode", "navigation_enabled", "dedup_executed"],
  "properties": {
    "schema_version": {"const": "city-route-1"},
    "route_semantic_id": {"type": "string", "pattern": "^rs:[a-f0-9]{24}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_trace_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "road_graph_version": {"type": "string"},
    "extraction_version": {"type": "string"},
    "planning_mode": {"const": "foot"},
    "observed_activity_type": {"type": ["string", "null"]},
    "source_authorization_status": {"type": "string"},
    "start_anchor": {"anyOf": [{"$ref": "#/$defs/anchor"}, {"type": "null"}]},
    "end_anchor": {"anyOf": [{"$ref": "#/$defs/anchor"}, {"type": "null"}]},
    "definitions": {"type": "array", "items": {"type": "object", "required": ["source_part", "ordered_segments"], "properties": {"source_part": {"type": "integer", "minimum": 0}, "ordered_segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}}}},
    "ordered_segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "distance": {"type": "object", "required": ["observed_m", "estimated_m", "reconstructed_m"], "properties": {"observed_m": {"type": "number", "minimum": 0}, "estimated_m": {"type": ["number", "null"]}, "reconstructed_m": {"type": ["number", "null"]}}},
    "elevation_gain": {"type": ["number", "null"]},
    "confidence": {"type": ["number", "null"]},
    "independent_evidence_count": {"type": ["integer", "null"]},
    "reconstruction_status": {"enum": ["candidate", "review", "failed", "resource_limited", "invalid"]},
    "version_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "core_fingerprint": {"type": ["string", "null"]},
    "road_type_preferences": {"type": "object"},
    "mandatory_edges": {"type": "array"},
    "forbidden_edges": {"type": "array"},
    "dedup_executed": {"const": false},
    "navigation_enabled": {"const": false}
  },
  "$defs": {
    "anchor": {
      "type": "object", "required": ["id", "coordinate", "coordinate_role", "coordinate_origin"],
      "properties": {
        "id": {"type": "string", "pattern": "^control:[a-f0-9]{24}$"},
        "coordinate": {"type": "array", "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}], "items": false, "minItems": 2},
        "coordinate_role": {"const": "planning_constraint"},
        "coordinate_origin": {"enum": ["observed_endpoint", "robust_estimate"]},
        "entity_candidate_id": {"type": "string"},
        "entity_relation": {"const": "nearby_unconfirmed"}
      }
    },
    "segment": {
      "type": "object", "required": ["from_anchor_id", "to_anchor_id", "from", "to", "mode", "corridor_id", "source_part", "break_before"],
      "properties": {
        "from_anchor_id": {"type": "string"}, "to_anchor_id": {"type": "string"},
        "from": {"$ref": "#/$defs/anchor"}, "to": {"$ref": "#/$defs/anchor"},
        "mode": {"const": "foot"}, "corridor_id": {"type": "string"},
        "source_part": {"type": "integer", "minimum": 0}, "break_before": {"type": "boolean"},
        "mandatory_edges": {"type": "array"}, "forbidden_edges": {"type": "array"},
        "road_constraint_resolution": {"const": "window_level_evidence"}
      }
    }
  }
}
